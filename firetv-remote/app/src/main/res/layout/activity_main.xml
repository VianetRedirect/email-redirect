<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="6dp"
    android:paddingBottom="14dp">

    <!-- Top bar: device chip + overflow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/deviceChip"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:background="@drawable/bg_device_chip"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/deviceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:text="@string/no_device"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMore"
            style="@style/IconButton"
            android:layout_marginLeft="6dp"
            android:src="@drawable/ic_more"
            android:contentDescription="@string/btn_more" />
    </LinearLayout>

    <!-- Back / Home / Menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/RoundButton"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/btn_back" />

        <ImageButton
            android:id="@+id/btnHome"
            style="@style/RoundButton"
            android:layout_marginLeft="30dp"
            android:src="@drawable/ic_home"
            android:contentDescription="@string/btn_home" />

        <ImageButton
            android:id="@+id/btnMenu"
            style="@style/RoundButton"
            android:layout_marginLeft="30dp"
            android:src="@drawable/ic_menu"
            android:contentDescription="@string/btn_menu" />
    </LinearLayout>

    <!-- D-pad fills whatever height is left -->
    <com.vianetredirect.firetvremote.DpadView
        android:id="@+id/dpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Rewind / Play-Pause / Fast forward -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnRewind"
            style="@style/RoundButton"
            android:src="@drawable/ic_rewind"
            android:contentDescription="@string/btn_rewind" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            style="@style/RoundButton"
            android:layout_marginLeft="30dp"
            android:src="@drawable/ic_play_pause"
            android:contentDescription="@string/btn_play_pause" />

        <ImageButton
            android:id="@+id/btnForward"
            style="@style/RoundButton"
            android:layout_marginLeft="30dp"
            android:src="@drawable/ic_forward"
            android:contentDescription="@string/btn_forward" />
    </LinearLayout>

    <!-- Keyboard / Apps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnKeyboard"
            style="@style/PillButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:drawableLeft="@drawable/ic_keyboard"
            android:text="@string/btn_keyboard" />

        <Button
            android:id="@+id/btnApps"
            style="@style/PillButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="12dp"
            android:drawableLeft="@drawable/ic_apps"
            android:text="@string/btn_apps" />
    </LinearLayout>
</LinearLayout>
